# Dokploy: Project > Environment (shared variables). Defined once, referenced from each app's own Environment as ${{project.NAME}}.
# Only values that two or more apps must agree on live here; everything else is app specific (apps/<service>/.env.example).

# Internal URLs: <App Name> is shown under the service name in Dokploy (project-service-hash).
NINEROUTER_URL=http://<App Name 9router>:20128/v1
LLM_PROXY_URL=http://<App Name llm-proxy>:20129

# supermemory-server and zed-adapter. Any string while 9router REQUIRE_API_KEY=false; afterwards a key created in the 9router dashboard.
OPENAI_API_KEY=

# supermemory-server and llm-proxy. The proxy fills it into /embeddings, so they must be equal. Change it together with the embedding model.
SUPERMEMORY_EMBEDDING_DIMENSIONS=768
