{
	"port": 20131,
	"host": "127.0.0.1",
	"healthEndpoint": ["/healthz"],
	"outputTransport": "streamableHttp",
	"stateful": true,
	"mcpServers": {
		"context7": {
			"url": "https://mcp.context7.com/mcp",
			"type": "http",
			"headers": { "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}" }
		},
		"chrome-devtools-mcp": {
			"command": "bunx",
			"args": ["--bun", "chrome-devtools-mcp@latest"]
		},
		"playwright": {
			"command": "bunx",
			"args": ["--bun", "@playwright/mcp@latest"]
		},
		"playwright-firefox": {
			"command": "bunx",
			"args": ["--bun", "@playwright/mcp@latest", "--browser=firefox"]
		},
		"pdfcraft": {
			"command": "pdfcraft-cli",
			"args": ["mcp", "--compact", "--root", "${HOME}"]
		},
		"figcraft": {
			"command": "python3",
			"args": ["${HOME}/.agents/skills/figcraft/scripts/mcp-proxy.py"]
		},
		"bruno": {
			"command": "bunx",
			"args": ["--bun", "@usebruno/mcp@latest"]
		}
	}
}
