{
	"name": "supermemory-local",
	"version": "1.0.0",
	"author": "Irfnd <irfandiabimanyu@gmail.com>",
	"license": "MIT",
	"description": "Self-hosted Supermemory with 9router, run by docker compose, plus hooks for Claude Code, Antigravity and OpenCode",
	"type": "module",
	"private": true,
	"bin": {
		"supermemory-hook": "./bin/supermemory-hook.ts"
	},
	"scripts": {
		"start": "bash scripts/start.sh",
		"start:mcp": "bash scripts/start.sh --mcp-only",
		"stop": "bash scripts/stop.sh",
		"stop:mcp": "bash scripts/stop.sh --mcp-only",
		"status": "bash scripts/status.sh",
		"logs": "docker compose -f docker-compose.yml -f docker-compose.local.yml logs -f",
		"mcp:check": "bash -c 'set -a; source .env; set +a; supergateway --config mcp-config.json --checkConfig'",
		"install-hooks": "bun apps/hooks/src/installer/main.ts install",
		"uninstall-hooks": "bun apps/hooks/src/installer/main.ts uninstall",
		"test-memory": "bun apps/hooks/src/self-test/main.ts",
		"test": "bun test",
		"typecheck": "bun run --filter '@supermemory-local/*' typecheck",
		"format": "bun --bun prettier --write .",
		"format:check": "bun --bun prettier --check ."
	},
	"keywords": [
		"supermemory",
		"9router",
		"memory",
		"claude-code",
		"antigravity",
		"opencode",
		"local-ai"
	],
	"devDependencies": {
		"@irfnd/prettier-config": "^1.5.4",
		"@opencode-ai/plugin": "^1.18.33",
		"@types/bun": "^1.4.2",
		"prettier": "^3.9.9",
		"typescript": "^7.0.2"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
