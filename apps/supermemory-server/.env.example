# Dokploy: Application > Environment. Mount a Volume at /data (Advanced > Volumes), domain -> container port 6767.
# Internal URL of the llm-proxy app: http://<llm-proxy App Name>:20129
OPENAI_BASE_URL=
# Any string while 9router REQUIRE_API_KEY=false; afterwards a key created in the 9router dashboard
OPENAI_API_KEY=
OPENAI_MODEL=cc/claude-haiku-4-5-20251001
# The store under /data is named after model+dimensions and locked to them: change both together (a new model = a new store)
SUPERMEMORY_EMBEDDING_PROVIDER=local
SUPERMEMORY_EMBEDDING_MODEL=Xenova/bge-base-en-v1.5
SUPERMEMORY_EMBEDDING_DIMENSIONS=768
