# Dokploy: Application > Environment. Mount a Volume at /data (Advanced > Volumes), domain -> container port 6767.
# From the project variables (dokploy.env.example):
OPENAI_BASE_URL=${{project.LLM_PROXY_URL}}
OPENAI_API_KEY=${{project.OPENAI_API_KEY}}
SUPERMEMORY_EMBEDDING_DIMENSIONS=${{project.SUPERMEMORY_EMBEDDING_DIMENSIONS}}

# App specific:
OPENAI_MODEL=cc/claude-haiku-5-5(low)
# The store under /data is named after model+dimensions and locked to them: change model and the shared dimensions together (a new model = a new store)
SUPERMEMORY_EMBEDDING_PROVIDER=local
SUPERMEMORY_EMBEDDING_MODEL=Xenova/bge-base-en-v1.5
# Ingest queue: documents processed at once (default 2) and the memory budget they share. 5 + 5gb ran ~50 docs/min on the VPS
# (11.7 GB RAM). The queue lives in memory: a redeploy drops it and leaves queued documents stuck, so change these only when
# the queue is empty (`bun run migrate import --resend-status queued` re-sends the stuck ones).
SUPERMEMORY_INGEST_CONCURRENCY=5
SUPERMEMORY_EMBEDDING_RAM_LIMIT=5gb
