# Dokploy: Application > Environment. No public domain, only supermemory-server calls it (container port 20129).
# Internal URL of the 9router app: http://<9router App Name>:20128/v1
OPENAI_BASE_URL=
# Must equal the value on supermemory-server (the proxy fills it into /embeddings)
SUPERMEMORY_EMBEDDING_DIMENSIONS=768
