# Dokploy: Application > Environment. Domain -> container port 20130, protected by ZED_ADAPTER_TOKEN.
# Internal URL of the 9router app: http://<9router App Name>:20128/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Zed sends this as its api_key; without it the adapter is open to anyone
ZED_ADAPTER_TOKEN=
ZED_ADAPTER_REASONING_EFFORT=none
