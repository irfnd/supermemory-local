# ========================================================
# Supermemory Local Server Configuration
# ========================================================
PORT=6767
SUPERMEMORY_PORT=6767
SUPERMEMORY_DATA_DIR=./data
WORKFLOW_ENGINE=direct

# Fully-local embeddings (built-in ONNX runtime, no external API needed)
SUPERMEMORY_EMBEDDING_PROVIDER=local
SUPERMEMORY_EMBEDDING_MODEL=Xenova/bge-base-en-v1.5
SUPERMEMORY_EMBEDDING_DIMENSIONS=768

# 9router Gateway (Local OpenAI-compatible API)
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_API_KEY=<your-9router-api-key>
OPENAI_MODEL=ag/gemini-3.8-flash-low

# Supermemory Client API (Used by hooks)
SUPERMEMORY_API_URL=http://127.0.0.1:6767
SUPERMEMORY_API_KEY=sm_local_key

# 9router Settings
NINEROUTER_PORT=20128
NINEROUTER_HOST=127.0.0.1

# LLM proxy between supermemory and 9router (forces "stream": false)
LLM_PROXY_PORT=20129

# Zed edit-prediction adapter (/v1/completions -> 9router, uses OPENAI_BASE_URL + OPENAI_API_KEY above)
ZED_ADAPTER_PORT=20130
ZED_ADAPTER_REASONING_EFFORT=none
