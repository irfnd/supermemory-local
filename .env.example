# ========================================================
# Supermemory Local Server Configuration
# ========================================================
PORT=6767
SUPERMEMORY_PORT=6767
# Logs + one store per embedding model (data/stores/<model>-<dims>d, data/current = active)
SUPERMEMORY_DATA_DIR=./data
WORKFLOW_ENGINE=direct

# Embeddings. Default: local bge-base-en (built-in ONNX, English-only), with TRANSLATE_MODEL turning non-English
# prompts/summaries into English first. Alternative: a multilingual 9router model, e.g.
#   SUPERMEMORY_EMBEDDING_PROVIDER=openai-compatible, SUPERMEMORY_EMBEDDING_MODEL=jina/jina-embeddings-v4,
#   SUPERMEMORY_EMBEDDING_DIMENSIONS=1024, TRANSLATE_MODEL= (empty)
# Switching model = edit + `bun run stop && bun run start`; each model keeps its own store (README "Mengganti Model").
SUPERMEMORY_EMBEDDING_PROVIDER=local
SUPERMEMORY_EMBEDDING_MODEL=Xenova/bge-base-en-v1.5
SUPERMEMORY_EMBEDDING_DIMENSIONS=768
# 9router chat model that translates non-English text to English before embedding. Empty = off.
TRANSLATE_MODEL=ag/gemini-3.8-flash-low

# Supermemory Client API (Used by hooks)
SUPERMEMORY_API_URL=http://127.0.0.1:6767
SUPERMEMORY_API_KEY=sm_local_key

# 9router Settings
NINEROUTER_PORT=20128
NINEROUTER_HOST=127.0.0.1

# Proxy between supermemory and 9router (forces "stream": false on chat, fills `dimensions` on embeddings)
LLM_PROXY_PORT=20129

# 9router Gateway (Local OpenAI-compatible API). OPENAI_MODEL = LLM for memory extraction (needs JSON + tool calling)
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_API_KEY=your-9router-api-key
OPENAI_MODEL=ag/gemini-3.8-flash-low

# Zed edit-prediction adapter (/v1/completions -> 9router)
ZED_ADAPTER_PORT=20130
ZED_ADAPTER_REASONING_EFFORT=none
