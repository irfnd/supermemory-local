# One file for docker compose (variable interpolation) and for the hooks (bun --env-file).
# Dokploy does not read this file: its variables are in dokploy.env.example (shared) and apps/<service>/.env.example (per app).

# --- Shared by several services (Dokploy: project variables) -------------------------------------------------
# LLM for memory extraction (needs JSON + tool calling) and for the Zed adapter, through the 9router container
OPENAI_API_KEY=your-9router-api-key
# supermemory-server and llm-proxy must agree on it; change it together with the embedding model
SUPERMEMORY_EMBEDDING_DIMENSIONS=768

# --- 9router -------------------------------------------------------------------------------------------------
NINEROUTER_PASSWORD=change-me
NINEROUTER_REQUIRE_API_KEY=false
# Local: bind mount, so ~/.9router keeps your logins. Dokploy: unset (named volume).
NINEROUTER_DATA=${HOME}/.9router

# --- supermemory-server --------------------------------------------------------------------------------------
# Local: bind mount, so ./data keeps the stores of earlier runs. Dokploy: unset (named volume).
SUPERMEMORY_DATA=./data/supermemory
# Memory extraction model. Measured on the VPS through llm-proxy: ~2-4s per call (free `glm` models got 503 once their account was locked)
OPENAI_MODEL=cc/claude-haiku-5-5(low)
# Embeddings. Default: local bge-base-en (built-in ONNX, English-only), with TRANSLATE_MODEL turning non-English
# prompts/summaries into English first. Alternative: a multilingual 9router model, e.g.
#   SUPERMEMORY_EMBEDDING_PROVIDER=openai-compatible, SUPERMEMORY_EMBEDDING_MODEL=jina/jina-embeddings-v4,
#   SUPERMEMORY_EMBEDDING_DIMENSIONS=1024, TRANSLATE_MODEL= (empty)
# Switching model = edit + `bun run stop && bun run start`; each model keeps its own store (README "Mengganti Model").
SUPERMEMORY_EMBEDDING_PROVIDER=local
SUPERMEMORY_EMBEDDING_MODEL=Xenova/bge-base-en-v1.5

# --- zed-adapter ---------------------------------------------------------------------------------------------
ZED_ADAPTER_TOKEN=
ZED_ADAPTER_REASONING_EFFORT=none

# --- This Mac only (hooks, supergateway; never copied to Dokploy) --------------------------------------------
# Hooks reach the containers through the published ports. Remote server: https URLs + the server's api key.
SUPERMEMORY_API_URL=http://127.0.0.1:6767
# Server on the VPS through `ssh contaboo-tunnel` (bun run launchd install keeps it up): http://localhost:6767
# Server on the VPS over HTTPS without the tunnel: https://memory.example.com, and fill CURL_IMPERSONATE below.
# Every request needs the server's key (supermemory-server 0.0.9+). Unset: read it from data/supermemory/current/api-key (local compose).
# Remote server or SSH tunnel: paste the key (`cat /data/current/api-key` in the container). Empty = no key, only for servers up to 0.0.8.
# SUPERMEMORY_API_KEY=
# Send every Mac-side request through libcurl-impersonate instead of fetch (Bun cannot fake the TLS/HTTP2 fingerprint).
# Fill for a VPS over HTTPS, e.g. chrome152_macos; empty = plain fetch, which is what the SSH tunnel needs.
# Requires `brew install curl-impersonate` (or CURL_IMPERSONATE_BIN=/path/to/curl-impersonate).
# When filled, launchd also starts the egress proxy on 20128/20130 so Zed and OpenCode (which do their own TLS) can
# talk plain HTTP to it instead of hitting the inspected certificate.
# CURL_IMPERSONATE=chrome152_macos
# curl-impersonate resolves names with c-ares, not the macOS resolver. If every call dies with
# "Could not resolve host ... (Timeout while contacting DNS servers)", point it at reachable resolvers.
# CURL_DNS_SERVERS=1.1.1.1,8.8.8.8
# Upstream of the egress proxy's :20130 listener; Zed's edit_predictions uses it.
# EGRESS_ZED_URL=https://zed-adapter.irfnd.id
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
# Chat model that translates non-English text to English before embedding (runs inside hooks, so it must answer in seconds). Empty = off.
TRANSLATE_MODEL=ollama/gpt-oss:120b
# MCP gateway (supergateway reads mcp-config.json; ${VAR} there come from this file). An unset ${VAR} aborts the gateway,
# and `bun run launchd install` refuses to run until every one of them is set.
CONTEXT7_API_KEY=
# MCP_GATEWAY_PORT=20131
